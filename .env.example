# Credencial del bot, de @BotFather. Sin esto el bot no arranca.
TELEGRAM_BOT_TOKEN=

# Chats autorizados, separados por coma. Cualquier otro recibe una negativa.
TELEGRAM_CHATS_AUTORIZADOS=

# Punto de venta y moneda. Fijos: el usuario compra siempre en Colombia.
MERCADO=CO
MONEDA=USD
IDIOMA=es

# Vigilancia
INTERVALO_SONDEO_HORAS=4
JITTER_MAXIMO_MINUTOS=20
UMBRAL_BAJADA_PORCENTAJE=5
MAX_BUSQUEDAS_ACTIVAS=5
SONDEOS_FALLIDOS_PARA_MARCAR_FALLIDA=3
BLOQUES_EN_SEGUIMIENTO=3

# Resumen diario
HORA_RESUMEN=08:00
ZONA_HORARIA=America/Bogota

# Rutas
RUTA_BD=./datos/vuelos.db
RUTA_LOGS=./datos/logs
